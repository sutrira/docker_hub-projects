# ==============================================================================
# Central Docker Build & Publishing Configuration
# ==============================================================================
# This file externalizes shared properties, namespaces, tags, and architectures
# across all Docker builds, local build scripts, and the GitHub Actions CI/CD pipeline.
# ==============================================================================

# Docker Hub Registry & Namespace
DOCKER_REGISTRY=docker.io
DOCKERHUB_NAMESPACE=sutrira

# GitHub Repository Reference
GITHUB_REPO_URL=git@github.com:sutrira/docker_hub-projects.git
GITHUB_HTTP_URL=https://github.com/sutrira/docker_hub-projects
MAINTAINER=sutrira

# Base Operating System Image (100% Alpine Linux based)
ALPINE_VERSION=3.24.1
BASE_IMAGE=alpine:3.24.1

# Target Multi-Architecture Platforms
DEFAULT_PLATFORMS=linux/amd64,linux/arm64

# ------------------------------------------------------------------------------
# Consolidated Repository Namespaces on Docker Hub
# ------------------------------------------------------------------------------
REPO_JDK=openjdk
REPO_JRE=openjdk-jre

# ------------------------------------------------------------------------------
# Active LTS Releases & Package Versions (Alpine 3.24.1 APK channel)
# ------------------------------------------------------------------------------
# Default LTS Version (receives the :latest tag)
LATEST_LTS=25

# OpenJDK 21 (LTS)
JAVA21_VERSION=21.0.12_p8-r0
JAVA21_MAJOR=21

# OpenJDK 25 (LTS)
JAVA25_VERSION=25.0.4_p7-r0
JAVA25_MAJOR=25

# ------------------------------------------------------------------------------
# CI/CD Security & Cache Configuration
# ------------------------------------------------------------------------------
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_IGNORE_UNFIXED=true
BUILD_CACHE_TYPE=gha
